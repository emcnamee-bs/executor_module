[Unit]
# The live executor for trade profile trades/kxaprpotus/ (market series KXAPRPOTUS):
# news scan -> keyphrase match (or direct source) -> local relevance gate (Ollama,
# the profile's gateModel, HANDOFF.md Sec 5a.4) -> Sonnet triage -> Sonnet decide ->
# sizing and caps -> real order execution against Kalshi (unless KALSHI_DRY_RUN=true).
# Consumes the local `iip:items` Redis stream fed by this box's own iip.service
# instance (deploy/mini-mac/iip.service) -- both run on mini-mac, nothing here talks
# to any other host.
#
# A systemd USER unit, matching iip.service's own reasoning: the process owns only
# its own files and needs no elevated capability to run.
Description=executor_module -- Kalshi KXAPRPOTUS live trading (trades/kxaprpotus)
Documentation=file:%h/executor_module/HANDOFF.md
After=network-online.target redis-server.service iip.service
Wants=network-online.target

# Same restart-storm circuit breaker as iip.service: 30 restarts in an hour trips the
# unit into `failed` and keeps it visibly failed rather than looping quietly on a
# real-money system.
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple
WorkingDirectory=%h/executor_module

# Every secret this process needs (KALSHI_API_KEY_ID, KALSHI_PRIVATE_KEY_PATH,
# ANTHROPIC_API_KEY, SLACK_WEBHOOK_URL, REDIS_URL) lives ONLY in
# %h/executor_module/.env -- .env* is already gitignored in this repo -- and is
# never written to this tracked unit file. main.ts itself fails loudly at startup
# naming any required variable that's absent (HANDOFF.md Sec 5a.1), so a missing
# .env fails the same way a missing variable already does, not silently.
EnvironmentFile=%h/executor_module/.env
# THIS unit's own switches -- KALSHI_DRY_RUN (the operator's explicit live/dry-run
# choice) and EXECUTOR_TRADING_HALTED (the live kill switch) -- go in .env.kxaprpotus,
# read only by this unit. The shared .env is also read by every paper unit, so it must
# carry neither (a halt there silently halts every paper unit too). HANDOFF.md Sec 5a.5.
EnvironmentFile=-%h/executor_module/.env.kxaprpotus

Environment=IIP_SOURCES_FILE=%h/Internet_Info_Plug/config/sources.minimac.yaml

# Ollama installs as a system-level unit; this is a user-level unit, so a bare
# `After=ollama.service` cannot order across that systemd namespace boundary --
# it would silently resolve to nothing and do nothing. This bounded-retry probe
# is the real substitute: up to 30 attempts (60s) waiting for Ollama's own API
# to answer before this service's main process starts. If Ollama never comes
# up, this ExecStartPre fails, the whole unit fails to start, and the existing
# Restart=always/RestartSec=10 retries the entire sequence -- including this
# probe again -- rather than starting the main process against a dependency
# that was never ready.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && exit 0; sleep 2; done; echo "Ollama not ready after 60s" >&2; exit 1'

# Which trade this unit runs, pinned on the command line where no env file can override
# it (systemd lets EnvironmentFile= beat Environment=; final review C1).
# EXECUTOR_LIVE_TRADE is what lets main.ts place real orders for this profile at all:
# a live start without EXECUTOR_LIVE_TRADE=<profile name> is refused, and only this
# unit sets it. KALSHI_DRY_RUN is deliberately NOT pinned here.
ExecStart=/usr/bin/env EXECUTOR_TRADE=kxaprpotus EXECUTOR_LIVE_TRADE=kxaprpotus %h/executor_module/node_modules/.bin/tsx %h/executor_module/src/main.ts

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=executor-module

# Hardening, matching iip.service's own pattern -- this process reads its own repo,
# writes its own SQLite ledger (and its .lock file) under data/, and makes outbound
# calls (Anthropic, Kalshi, Ollama and Redis over localhost, Slack); it has no reason
# to touch anything else.
#
# MemoryDenyWriteExecute is deliberately OMITTED here, unlike iip.service: verified
# empirically (2026-09-01) that Node's V8 JIT needs W^X page transitions this
# directive's seccomp filter kills outright -- the process core-dumped on every
# start (signal=TRAP) until this was removed. iip.service is a pure Python process
# and doesn't hit this; a JIT'd runtime does.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/executor_module/data %h/executor_module/logs
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
